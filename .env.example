# Copy to .env. This file uses Bash assignment syntax; quote paths with spaces.
# Empty = <repository>/runtime. On a server, optionally set an absolute data-disk path.
# Example: AGENTIC_ROOT=/home/h50061831/learn-verl-v0.5.0/runtime
AGENTIC_ROOT=

# Optional: smoke tests default to python3 from the active environment.
# PYTHON_BIN=/absolute/path/to/training/environment/bin/python3

# Machine paths and service credentials belong here.
# Training hyperparameters belong in project/configs/, not here.
# Never commit real API keys. Do not put secrets in .env.example.
